credentials:
  system:
    domainCredentials:
      - credentials:

          # ================================================================
          # Jenkins Permanent Agent SSH Credential
          # ================================================================
          - basicSSHUserPrivateKey:
              scope: GLOBAL
              id: "dp-jenkins-agent-ssh"
              username: "{{ jenkins_agent_user }}"
              description: "DP Jenkins SSH credential for permanent agents"
              privateKeySource:
                directEntry:
                  privateKey: |-
{{ jenkins_agent_private_key_content | indent(20, true) }}

          # ================================================================
          # GitHub Personal Access Token
          # ================================================================
          - usernamePassword:
              scope: GLOBAL
              id: "github-token"
              username: "davidakud1-eng"
              password: "{{ vault_github_token }}"
              description: "GitHub credential for DP Jenkins pipelines"

          # ================================================================
          # SonarQube Cloud Token
          # ================================================================
          - string:
              scope: GLOBAL
              id: "sonarcloud-token"
              secret: "{{ vault_sonarcloud_token }}"
              description: "DP SonarQube Cloud Token"

          # ================================================================
          # Ansible Vault Password
          # ================================================================
          - string:
              scope: GLOBAL
              id: "ansible-vault-password"
              secret: "{{ vault_ansible_vault_password }}"
              description: "DP Ansible Vault password for Jenkins automation"

          # ================================================================
          # Snyk API Token
          # ================================================================
          - defaultSnykApiToken:
              scope: GLOBAL
              id: "snyk-token"
              token: "{{ vault_snyk_token }}"
              description: "DP Snyk API token for CI/CD security scanning"