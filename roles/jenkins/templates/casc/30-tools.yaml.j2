---
# ============================================================================
# Jenkins Global / Tool Configuration
# ============================================================================

unclassified:

  # ==========================================================================
  # SonarCloud
  # ==========================================================================

  sonarGlobalConfiguration:
    installations:
      - name: "DP-SonarCloud"
        serverUrl: "https://sonarcloud.io"
        credentialsId: "sonarcloud-token"
        triggers:
          skipScmCause: false
          skipUpstreamCause: false

  # ==========================================================================
  # JFrog Platform
  # ==========================================================================

  jFrogPlatformBuilder:
    allowHttpConnections: true
    jfrogInstances:
      - serverId: "DP-Artifactory"
        url: "http://{{ platform_ops_private_ip }}:{{ artifactory_router_port }}"
        artifactoryUrl: "http://{{ platform_ops_private_ip }}:{{ artifactory_router_port }}/artifactory"
        credentialsConfig:
          credentialsId: "artifactory-token"

# ============================================================================
# Jenkins Tools
# ============================================================================

tool:

  # ==========================================================================
  # Snyk CLI
  # ==========================================================================

  snyk:
    installations:
      - name: "DP-Snyk"
        properties:
          - installSource:
              installers:
                - snykInstaller:
                    platform: AUTO
                    updatePolicyIntervalHours: 24
                    version: "latest"

  # ==========================================================================
  # JFrog CLI
  # ==========================================================================

  jfrog:
    installations:
      - name: "DP-JFrog-CLI"
        properties:
          - installSource:
              installers:
                - "releasesInstaller"