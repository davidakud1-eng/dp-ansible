---
# ============================================================================
# Jenkins Global / Tool Configuration
# ============================================================================

unclassified:

  # ==========================================================================
  # SonarCloud
  # ==========================================================================

  sonarGlobalConfiguration:
    installations:
      - name: "DP-SonarCloud"
        serverUrl: "https://sonarcloud.io"
        credentialsId: "sonarcloud-token"
        triggers:
          skipScmCause: false
          skipUpstreamCause: false

# ============================================================================
# Jenkins Tools
# ============================================================================

tool:

  # ==========================================================================
  # Snyk CLI
  # ==========================================================================

  snyk:
    installations:
      - name: "DP-Snyk"
        properties:
          - installSource:
              installers:
                - snykInstaller:
                    platform: AUTO
                    updatePolicyIntervalHours: 24
                    version: "latest"